# Production Environment Variables
# Use these on Render or your production environment

# Node Environment
NODE_ENV=production

# Server Port (Render sets this automatically)
PORT=3000

# Database URL - Set this in Render dashboard or .env file
DATABASE_URL=postgresql://user:password@host:port/database

# CORS Configuration
CORS_ORIGIN=https://your-render-url.onrender.com

# Backend URL (for API proxying in production)
BACKEND_URL=https://your-render-url.onrender.com

# Optional: API Keys and Secrets
# STRIPE_KEY=sk_live_...
# JWT_SECRET=your-secret-key-here
# NEXT_PUBLIC_API_URL=https://your-render-url.onrender.com/api

# Optional: Feature Flags
# LOG_LEVEL=info
# ENABLE_ANALYTICS=true
