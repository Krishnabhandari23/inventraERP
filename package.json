{
  "name": "inventra-ui-starter",
  "version": "1.7.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"next dev\" \"cd backend && npm run dev\"",
    "dev:combined": "NODE_ENV=development node server.js",
    "build": "next build",
    "build:all": "npm install && npm run build && cd backend && npm install && npm run build && cd ..",
    "start": "NODE_ENV=production node server.js",
    "start:prod": "npm run build:all && npm run start"
  },
  "dependencies": {
    "@prisma/client": "5.20.0",
    "js-cookie": "3.0.5",
    "next": "14.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "stripe": "14.25.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "autoprefixer": "10.4.19",
    "concurrently": "^8.2.0",
    "postcss": "8.4.38",
    "prisma": "5.20.0",
    "tailwindcss": "3.4.10",
    "typescript": "5.5.4"
  },
  "packageManager": "pnpm@9.7.0"
}
